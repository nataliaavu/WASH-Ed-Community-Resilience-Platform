# HOW TO SET UP
# 1. Copy this file:  copy .env.example .env   (Windows) / cp .env.example .env (Mac/Linux)
# 2. Fill in your keys below
# 3. Never commit .env to GitHub — it is already in .gitignore

PORT=3000

# Meteosource Weather API — required to show live weather
# Get your key at: https://www.meteosource.com/dashboard
# The app uses the Startup plan endpoint (/api/v1/startup)
METEOSOURCE_API_KEY=your_meteosource_key_here

# Google Flood Forecasting API — optional
# Leave blank to use built-in mock flood data instead
# Get a key at: https://console.cloud.google.com (enable Flood Forecasting API)
GOOGLE_FLOOD_API_KEY=
